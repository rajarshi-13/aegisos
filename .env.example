# Supabase configuration
# Copy this file to `.env.local` and fill in your project values.

# Supabase project URL (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# n8n governance webhook URL (POST endpoint that returns verdict / reason)
VITE_N8N_GOVERNANCE_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/governance-check

# =====================================================================
# Edge Function secrets (set via `supabase secrets set`, NOT .env.local)
# These are used by the send-breach-email Edge Function.
# =====================================================================

# Google Gemini API key — used to compose the breach notification email
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Resend API key — used to deliver the email
# Get one at https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Verified sender email address in Resend (e.g. notifications@yourdomain.com)
RESEND_FROM_EMAIL=noreply@yourdomain.com
